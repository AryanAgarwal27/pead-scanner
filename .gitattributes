# Default: treat as text, normalize to LF in the repo, native on checkout.
* text=auto eol=lf

# Explicit LF for text formats we care about.
*.py   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf
*.toml text eol=lf
*.sh   text eol=lf

# Binary formats — never normalize.
*.png binary
*.jpg binary
*.pdf binary
